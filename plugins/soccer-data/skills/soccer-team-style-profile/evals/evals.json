        "no pressing claims without data"
      ]
    },
    {
      "prompt": "Compare Liverpool and City",
      "expect": [
        "both clubs on the same season and league",
        "derived numbers shown with formulas",
        "matches counted"
      ]
    },
    {
      "prompt": "Does Ajax press high?",
      "expect": [
        "states pressing intensity is not returned",
        "offers what the data does show",
        "no invented pressing metric"
      ]
    }
