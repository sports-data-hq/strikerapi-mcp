      "does this team take shots from distance",
      "is it a possession team",
      "how many shots do they concede",
      "what formation do they play",
      "does Newcastle create quality chances"
    ],
    "should_not": [
      "xG breakdown of Arsenal vs Chelsea",
      "preview Saturday's match",
      "simulate the Premier League",
      "anytime goalscorer prices",
      "Premier League table",
      "tennis serve style",
      "NFL offensive tendencies",
      "build a clustering model of team styles",
      "Haaland over-performing xG",
      "who won the league last year"
    ]
  }
